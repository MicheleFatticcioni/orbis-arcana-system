<div class="orbis-chat-roll">
  <div class="roll-header">
    <h2>{{label}}</h2>
  </div>
  <div class="divider"></div>

  <div class="roll-sections">
    {{#if hasAttribute}}
      <div class="roll-section attribute">
        <div class="section-header flexrow flex-between">
          <span class="section-label">{{attributeKey}}</span>
        </div>
        <div class="dice-row">
          {{#each attributeDice as |die|}}
            <img
              src="systems/spn-system/assets/dice/red-dice-{{die.result}}.png"
              class="die attribute-die"
              title="{{die.result}}"
            />
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if hasSkill}}
      <div class="roll-section skill">
        <div class="section-header flexrow flex-between">
          <span class="section-label">{{skillLabel}}</span>
        </div>
        <div class="dice-row">
          {{#each skillDice as |die|}}
            <img
              src="systems/spn-system/assets/dice/red-dice-{{die.result}}.png"
              class="die skill-die"
              title="{{die.result}}"
            />
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if hasCursed}}
      <div class="roll-section cursed">
        <div class="section-header flexrow flex-between">
          <span class="section-label">Dadi Maledetti</span>
        </div>
        <div class="dice-row">
          {{#each cursedDice as |die|}}
            <img
              src="systems/spn-system/assets/dice/red-dice-{{die.result}}.png"
              class="die cursed-die"
              title="{{die.result}}"
            />
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if hasModifier}}
      <div class="roll-section modifier">
        <div class="section-header flexrow flex-between">
          <span class="section-label">Bonus</span>
        </div>
        <div class="dice-row">
          {{#each modifierDice as |die|}}
            <img
              src="systems/spn-system/assets/dice/red-dice-{{die.result}}.png"
              class="die modifier-die"
              title="{{die.result}}"
            />
          {{/each}}
        </div>
      </div>
    {{/if}}
  </div>

  <div class="divider"></div>

  <div class="roll-footer flexcol flex-center">
    <div class="total-stats flexrow flex-between">
      <i class="fas fa-times"></i>
      {{successCount}}
      |
      <i class="fas fa-skull"></i>
      {{cursedCount}}
    </div>
    <div class="force-roll-container">
      <button class="force-roll-button" data-action="force-roll">FORZA!</button>
    </div>
  </div>
</div>