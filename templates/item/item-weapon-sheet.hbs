<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='attributes'>Proprietà</a>
    <a class='item' data-tab='description'>Descrizione</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Attributes Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>

      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.TYPE"}}</label>
        <select name='system.type' style="height: auto;">
          <option value='melee' {{#if (eq system.type "melee")}}selected{{/if}}>
            {{localize "SPN_SYSTEM.WEAPON.TYPE_MELEE"}}
          </option>
          <option value='throwing' {{#if (eq system.type "throwing")}}selected{{/if}}>
            {{localize "SPN_SYSTEM.WEAPON.TYPE_THROWING"}}
          </option>
          <option value='firearm' {{#if (eq system.type "firearm")}}selected{{/if}}>
            {{localize "SPN_SYSTEM.WEAPON.TYPE_RANGED"}}
          </option>
        </select>
      </div>

      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.DAMAGE"}}</label>
        <input
          type='number'
          name='system.damage'
          value='{{system.damage}}'
          min='0'
        />
      </div>

      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.RANGE"}}</label>
        <input
          type='text'
          name='system.range_meters'
          value='{{system.range_meters}}'
          placeholder='es. 5-20 / Engaged'
        />
      </div>

      {{#if (eq system.type "firearm")}}
      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.MAGAZINE"}}</label>
        <div class='resource-content flexrow flex-center'>
          <input type='number' name='system.ammo.value' value='{{system.ammo.value}}' min='0' />
          <span>/</span>
          <input type='number' name='system.ammo.max' value='{{system.ammo.max}}' min='0' />
        </div>
      </div>
      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.RESERVE"}}</label>
        <input type='number' name='system.ammo.reserve' value='{{system.ammo.reserve}}' min='0' />
      </div>
      {{/if}}

      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.COST"}}</label>
        <input
          type='number'
          name='system.cost_euro'
          value='{{system.cost_euro}}'
          min='0'
        />
      </div>

      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.HEALTH_STATUS"}}</label>
        <div class='condition-display'>
          {{#each (range 1 6)}}
            <span class='condition-dot {{#if (gte ../system.health_status.value this)}}filled{{/if}}' data-value='{{this}}' data-testid='condition-dot'></span>
          {{/each}}
        </div>
      </div>

    </div>
  </section>
</form>
