<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='attributes'>Proprietà</a>
    <a class='item' data-tab='description'>Descrizione</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Attributes Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.DAMAGE"}}</label>
        <input
          type='number'
          name='system.damage'
          value='{{system.damage}}'
          min='0'
        />
      </div>

      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.TYPE"}}</label>
        <select name='system.type' style="height: auto;">
          <option value='arma bianca' {{#if (eq system.type "arma bianca")}}selected{{/if}}>
            {{localize "SPN_SYSTEM.WEAPON.TYPE_MELEE"}}
          </option>
          <option value='arma da lancio' {{#if (eq system.type "arma da lancio")}}selected{{/if}}>
            {{localize "SPN_SYSTEM.WEAPON.TYPE_THROWING"}}
          </option>
          <option value='arma da fuoco' {{#if (eq system.type "arma da fuoco")}}selected{{/if}}>
            {{localize "SPN_SYSTEM.WEAPON.TYPE_RANGED"}}
          </option>
        </select>
      </div>

      {{#if (eq system.type "arma da fuoco")}}
      <div class='resource'>
        <label class='resource-label'>{{localize "SPN_SYSTEM.WEAPON.CONDITION"}}</label>
        <div class='condition-display'>
          {{#each (range 1 6)}}
            <span class='condition-dot {{#if (gte ../system.condition.value this)}}filled{{/if}}' data-value='{{this}}' data-testid='condition-dot'></span>
          {{/each}}
        </div>
      </div>
      {{/if}}

      
    </div>
  </section>
</form>
