<form class="orbis-roll-dialog">
  <div class="roll-header">
    <h1 class="roll-title">{{label}}</h1>
    <div class="roll-details">
      <span class="roll-detail">{{attributeLabel}}: {{attributeValue}}</span>
      <span class="roll-detail">{{skillLabel}}: {{skillValue}}</span>
    </div>
  </div>

  <div class="roll-modifier">
    <label>Modificatore</label>
    <div class="modifier-controls">
      <input type="number" name="modifier" value="0" autofocus />
    </div>
  </div>

</form>