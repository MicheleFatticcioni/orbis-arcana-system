<ol class="items-list doti-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize 'SPN_SYSTEM.FEATURE.NAME'}}</div>
    <div class="item-prop doti-level-header">{{localize 'SPN_SYSTEM.FEATURE.LEVEL'}}</div>
    <div class="item-controls">
      <a class="item-control item-create" title="{{localize 'SPN_SYSTEM.FEATURE.CREATE'}}" data-type="feature">
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>

  {{#each features as |item|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <div class="item-image">
          <img src="{{item.img}}" title="{{item.name}}" width="30" height="30"/>
        </div>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-prop doti-level rollable-level" data-item-id="{{item._id}}" title="{{localize 'SPN_SYSTEM.FEATURE.CYCLE_LEVEL'}}">
        {{item.system.currentLevel}}
      </div>
      <div class="item-controls">
        <a class="item-control item-edit" title="{{localize 'SPN_SYSTEM.FEATURE.EDIT'}}">
          <i class="fas fa-edit"></i>
        </a>
        <a class="item-control item-chat" data-item-id="{{item._id}}" title="{{localize 'SPN_SYSTEM.FEATURE.SHOW_CHAT'}}">
          <i class="fas fa-comment"></i>
        </a>
        <a class="item-control item-delete" title="{{localize 'SPN_SYSTEM.FEATURE.DELETE'}}">
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
