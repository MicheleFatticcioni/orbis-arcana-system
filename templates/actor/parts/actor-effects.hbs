<ol class="items-list effects-list">

  {{! Doti Section }}
  <div class="features-column">
    <div class="flexrow flex-between section-header-row">
      <h2 class="section-header">DOTI</h2>
      <a class="item-create" data-type="feature" title="Aggiungi Dote"><i
          class="fas fa-plus"
        ></i></a>
    </div>

    <ol class="items-list">
      {{#each features as |item|}}
        <li class="item flexrow" data-item-id="{{item._id}}">
          <div class="item-image"><img
              src="{{item.img}}"
              title="{{item.name}}"
              width="24"
              height="24"
            /></div>
          <h4
            class="item-name rollable"
            data-roll-type="item"
          >{{item.name}}</h4>
          <span class="item-name">Livello {{item.system.level}}</span>
          <div class="item-controls">
            <a class="item-control item-edit" title="Edit Item"><i
                class="fas fa-edit"
              ></i></a>
            <a class="item-control item-delete" title="Delete Item"><i
                class="fas fa-trash"
              ></i></a>
          </div>
        </li>
      {{/each}}
    </ol>
  </div>
</ol>