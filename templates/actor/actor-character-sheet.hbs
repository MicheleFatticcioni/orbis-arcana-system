<form class="{{cssClass}} {{actor.type}}" autocomplete="off">
  
  {{!-- Header: Name and Profession --}}
  <header class="sheet-header flexrow">
    <div class="header-details flexrow">
        <div class="charname">
            <label for="pgName" class="light-label">Nome Pg</label>
            <input id="pgName" name="actor.name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}"/>
        </div>
        <div class="profession">
            <label for="profession" class="light-label">Professione</label>
            <input id="profession" name="system.details.professione" type="text" value="{{system.details.professione}}" placeholder="Professione"/>
        </div>
    </div>
  </header>
    {{!-- Sheet Tab Navigation row header --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="features">Caratteristiche</a>
    <a class="item" data-tab="items">Equipaggiamento</a>
    <a class="item" data-tab="talents">Doti</a>
    <a class="item" data-tab="description">Descrizione</a>
  </nav>
  

  {{!-- Sheet Body --}}
  <section class="sheet-body">
      
      {{!-- Features Tab --}}
      <div class="tab features" data-group="primary" data-tab="features">

        <section class="attributes-row grid grid-4col">
            {{#each system.attributes as |attr key|}}
            <div class="attribute-card flexcol flex-group-center">
                <label class="attribute-label rollable" data-roll-type="attribute" data-key="{{key}}" data-label="{{localize (lookup @root.config.Attributes (lookup @root.config.Attributes key))}}">
                    {{localize (lookup @root.config.Attributes (lookup @root.config.Attributes key))}} {{!-- Fallback lookup --}}
                    {{#with (lookup @root.config.Attributes key) as |locParams|}}{{locParams}}{{else}}{{key}}{{/with}}
                </label>
                <div class="attribute-value">
                    <input type="text" name="system.attributes.{{key}}.value" value="{{attr.value}}" data-dtype="Number"/>
                </div>
            </div>
            {{/each}}
        </section>
        
          {{!-- Main Content: Skills & Vitals --}}
          <section class="sheet-main flexcol">

            <div class="skills-column">
              {{!-- Vitals (Tracks) --}}
              <h2 class="section-header">STATO VITALE</h2>
              <div class="vitals-column">

                <div class="skills-list grid"> 

                  <div class="track health-track">
                     <div class="flexrow flex-between">
                         <label class="health-label">{{localize "SPN_SYSTEM.Tracks.Health"}}</label>
                         <span>FISICO</span>
                     </div>
                     <div class="resource-content flexrow flex-center">
                         <input type="number" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
                         <span>/</span>
                         <input type="number" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"/>
                     </div>
                  </div>

                  <div class="track stress-track">
                     <div class="flexrow flex-between">
                         <label class="stress-label">{{localize "SPN_SYSTEM.Tracks.Stress"}}</label>
                         <span>MENTALE</span>
                     </div>
                     <div class="resource-content flexrow flex-center">
                         <input type="number" name="system.stress.value" value="{{system.stress.value}}" data-dtype="Number"/>
                         <span>/</span>
                         <input type="number" name="system.stress.max" value="{{system.stress.max}}" data-dtype="Number"/>
                     </div>
                  </div>

                   <div class="track cursed-track">
                     <div class="flexrow flex-between">
                         <label>{{localize "SPN_SYSTEM.Tracks.Cursed"}}</label>
                         <span>{{localize "SPN_SYSTEM.Tracks.Corruzione"}}</span>
                     </div>
                     <div class="resource-content flexrow flex-center">
                        {{!-- Simple Value input for now, ideally dots --}}
                        <input type="number" name="system.tracks.dadi_maledetti.value" value="{{system.tracks.dadi_maledetti.value}}" data-dtype="Number"/> 
                        <span>/ {{system.tracks.dadi_maledetti.max}}</span>
                     </div>
                  </div>

                </div>
              </div>
            </div>

              {{!-- Skills --}}
              <div class="skills-column">
                  <h2 class="section-header">ABILITÀ</h2>
                  <div class="skills-list grid grid-2col">
                    {{#each skillsByAttribute as |skills attrKey|}}
                    <div class="skill-group">
                        <h3 class="skill-group-header">{{localize (lookup @root.config.Attributes attrKey)}}</h3>
                        {{!-- Or just key metadata --}}
                        {{#each skills as |skill|}}
                        <div class="skill-item flexrow flex-between">
                            <span class="skill-name rollable" data-roll-type="skill" data-key="{{skill.key}}" data-label="{{skill.label}}">{{skill.label}}</span>
                            <input class="skill-input" type="text" name="system.skills.{{skill.key}}.value" value="{{skill.value}}" data-dtype="Number"/>
                        </div>
                        {{/each}}
                    </div>
                    {{/each}}
                  </div>
              </div>
          </section>

         
      </div>

      {{!-- Description Tab --}}
      <div class="tab biography" data-group="primary" data-tab="description">
         {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
      </div>

      {{!-- Items Tab (Zaino + Items) --}}
      <div class="tab items" data-group="primary" data-tab="items">
         {{!-- Inventory / Zaino --}}
          <section class="inventory-section">
              <h2 class="section-header">ZAINO</h2>
              <div class="gear-list">
                {{!-- Header Row --}}
                <div class="gear-list-header flexrow">
                  <div class="gear-col gear-col-img"></div>
                  <div class="gear-col gear-col-name">{{localize "Name"}}</div>
                  <div class="gear-col gear-col-desc">Descrizione</div>
                  <div class="gear-col gear-col-qty">Qt.</div>
                  <div class="gear-col gear-col-controls">
                    <a class="item-create" data-type="item" title="Aggiungi Oggetto"><i class="fas fa-plus"></i></a>
                  </div>
                </div>
                {{!-- Gear Rows --}}
                {{#each gear as |gitem|}}
                  <div class="gear-row flexrow item" data-item-id="{{gitem._id}}">
                    <div class="gear-col gear-col-img">
                      <img src="{{gitem.img}}" title="{{gitem.name}}" width="30" height="30"/>
                    </div>
                    <div class="gear-col gear-col-name">{{gitem.name}}</div>
                    <div class="gear-col gear-col-desc">{{gitem.system.description}}</div>
                    <div class="gear-col gear-col-qty">{{gitem.system.quantity}}</div>
                    <div class="gear-col gear-col-controls">
                      <a class="item-control item-edit" title="Modifica"><i class="fas fa-edit"></i></a>
                      <a class="item-control item-delete" title="Elimina"><i class="fas fa-trash"></i></a>
                    </div>
                  </div>
                {{/each}}
              </div>
          </section>

           {{!-- Weapons Section --}}
           <section class="weapons-section">
              <h2 class="section-header">ARMI</h2>
              <div class="weapons-list">
                {{!-- Header Row --}}
                <div class="weapons-list-header flexrow">
                  <div class="weapon-col weapon-col-img"></div>
                  <div class="weapon-col weapon-col-name">{{localize "Name"}}</div>
                  <div class="weapon-col weapon-col-type">{{localize "SPN_SYSTEM.WEAPON.TYPE"}}</div>
                  <div class="weapon-col weapon-col-damage">{{localize "SPN_SYSTEM.WEAPON.DAMAGE"}}</div>
                  <div class="weapon-col weapon-col-condition">{{localize "SPN_SYSTEM.WEAPON.CONDITION"}}</div>
                  <div class="weapon-col weapon-col-controls">
                    <a class="item-create" data-type="weapon" title="Aggiungi Arma"><i class="fas fa-plus"></i></a>
                  </div>
                </div>
                {{!-- Weapon Rows --}}
                {{#each weapons as |item|}}
                  <div class="weapon-row flexrow item" data-item-id="{{item._id}}">
                    <div class="weapon-col weapon-col-img">
                      <img src="{{item.img}}" title="{{item.name}}" width="30" height="30"/>
                    </div>
                    <div class="weapon-col weapon-col-name">{{item.name}}</div>
                    <div class="weapon-col weapon-col-type">{{item.system.type}}</div>
                    <div class="weapon-col weapon-col-damage">{{item.system.damage}}</div>
                    <div class="weapon-col weapon-col-condition">
                      <span class="condition-label {{conditionClass item.system.condition.value}}">{{conditionLabel item.system.condition.value}}</span>
                    </div>
                    <div class="weapon-col weapon-col-controls">
                      <a class="item-control item-edit" title="Modifica"><i class="fas fa-edit"></i></a>
                      <a class="item-control item-delete" title="Elimina"><i class="fas fa-trash"></i></a>
                    </div>
                  </div>
                {{/each}}
              </div>
          </section>

          {{!-- Generic Items List --}}
          {{> "systems/spn-system/templates/actor/parts/actor-items.hbs"}}
      </div>

      {{!-- Doti Tab --}}
      <div class="tab doti flexcol" data-group="primary" data-tab="talents">
        {{> "systems/spn-system/templates/actor/parts/actor-features.hbs"}}
      </div>

  </section>
</form>